# === СТАДИЯ 1: Сборка исполняемого бинарного файла ===
FROM golang:1.17-alpine AS build

# Определение рабочей директории внутри контейнера-сборщика
WORKDIR /src/

# Копирование исходного кода приложения в изолированную среду
COPY app.go /src/

# Компиляция статического бинарного файла
RUN CGO_ENABLED=0 go build -o /bin/demo app.go

# === СТАДИЯ 2: Формирование целевого минимального образа ===
FROM scratch

# Копирование скомпилированного бинарника из первой стадии
COPY --from=build /bin/demo /bin/demo

# Декларативное указание сетевого порта приложения
EXPOSE 8888

# Определение точки входа для запуска процесса
ENTRYPOINT ["/bin/demo"]
